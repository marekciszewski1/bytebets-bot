# Discord — https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
# Recommended for testing (instant slash commands). Server ID from Discord Developer Mode.
DISCORD_GUILD_ID=

# Supabase — Project Settings → API (use service_role key ONLY on the bot server, never in a website client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: comma-separated Discord user IDs allowed to use /admin
ADMIN_DISCORD_IDS=
