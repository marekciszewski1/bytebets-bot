{
  "name": "bytebets-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "register-commands": "tsx src/register-commands.ts",
    "validate:commands": "vitest run tests/commands/definitions.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:migrations": "tsx scripts/validate-migrations.ts",
    "verify:bet": "tsx scripts/verify-bet.ts",
    "setup:server": "tsx scripts/bootstrap-server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
